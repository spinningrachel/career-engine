  "pipe_closure": {
    "id": "pipe-closure",
    "_comment": "Every $PIPE/$RUN_PIPE/$QUEUE_PIPE file token a pipeline doc mentions must have at least one occurrence on a line with a write marker in that same doc — otherwise the doc reads a file nothing writes (the cv-final.md failure family, 2026-07-13). Exceptions list legitimate cross-file handoffs with the producing file named in the reason.",
    "files": [
      "skills/career-engine-new-application/SKILL.md",
      "skills/career-engine-edit/SKILL.md",
      "skills/career-engine-intake/SKILL.md",
      "skills/career-engine-orchestrator/orchestrator-queue.md",
      "skills/career-engine-orchestrator/orchestrator-post-run.md"
    ],
    "write_marker_regex": "writ|overwrit|OUTPUT_PATH=|CV_PATH=|LETTER_PATH=|save|sav(ed|ing)|append|copy|cp |cat >|land|creat|stag|restor|produce|establish",
    "exceptions": [
      {
        "file": "skills/career-engine-orchestrator/orchestrator-queue.md",
        "token": "$PIPE/queue.md",
        "reason": "comparative reference to intake's file — written by career-engine-intake/SKILL.md Step 0.5, not by this doc"
      }
    ]
  }
